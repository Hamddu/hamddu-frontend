{
  "expo": {
    "name": "Handdu",
    "slug": "knitting-community",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FF7325",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hamddu.app",
      "googleServicesFile": "./GoogleService-Info.plist",
      "entitlements": {
        "aps-environment": "development"
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FF7325"
      },
      "softwareKeyboardLayoutMode": "resize",
      "permissions": ["VIBRATE"],
      "blockedPermissions": ["android.permission.RECORD_AUDIO"],
      "package": "com.hamddu.app"
    },
    "web": {
      "bundler": "metro"
    },
    "scheme": "hamddu",
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "앱에서 사진을 선택하기 위해 권한이 필요합니다."
        }
      ],
      "expo-web-browser",
      "expo-notifications",
      [
        "@react-native-firebase/app",
        {
          "ios": {
            "disableSPM": true
          }
        }
      ],
      "@react-native-firebase/messaging",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "5e80d954-4642-498a-a372-fe2def8720bf"
      }
    }
  }
}
