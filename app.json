{
  "expo": {
    "name": "함뜨",
    "slug": "knitting-community",
    "version": "1.0.0",
    "icon": "./assets/icon/app-icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FF7325",
    "splash": {
      "backgroundColor": "#FF7326"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.hamddu.app",
      "googleServicesFile": "./GoogleService-Info.plist",
      "usesAppleSignIn": true,
      "entitlements": {
        "aps-environment": "$(APS_ENVIRONMENT)"
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDevelopmentRegion": "ko",
        "CFBundleLocalizations": ["ko", "en"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FF7325"
      },
      "softwareKeyboardLayoutMode": "resize",
      "permissions": ["VIBRATE"],
      "blockedPermissions": ["android.permission.RECORD_AUDIO"],
      "package": "com.hamddu.app"
    },
    "web": {
      "bundler": "metro"
    },
    "scheme": "hamddu",
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "기기에 저장된 뜨개 작품 사진을 커뮤니티 게시글, 챌린지 인증 사진, 프로필 사진으로 등록할 수 있도록 사진 보관함에 접근합니다. 회원님이 직접 고른 사진만 업로드되며 보관함의 다른 사진은 읽지 않습니다.",
          "cameraPermission": "완성한 뜨개 작품을 그 자리에서 촬영해 커뮤니티 게시글, 챌린지 인증 사진, 프로필 사진으로 등록할 수 있도록 카메라를 사용합니다. 촬영한 사진은 회원님이 등록을 선택한 게시물에만 업로드됩니다.",
          "microphonePermission": false
        }
      ],
      "expo-apple-authentication",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "enableBackgroundRemoteNotifications": true
        }
      ],
      [
        "@react-native-firebase/app",
        {
          "ios": {
            "disableSPM": true
          }
        }
      ],
      "@react-native-firebase/messaging",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static",
            "forceStaticLinking": [
              "RNFBApp",
              "RNFBMessaging"
            ]
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "5e80d954-4642-498a-a372-fe2def8720bf"
      }
    }
  }
}
