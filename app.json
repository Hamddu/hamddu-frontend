{
  "expo": {
    "name": "뜨개질 커뮤니티",
    "slug": "knitting-community",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#5A37A2",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yourcompany.knittingcommunity",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#5A37A2"
      },
      "package": "com.yourcompany.knittingcommunity",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "scheme": "hamddu",
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "앱에서 사진을 선택하기 위해 권한이 필요합니다."
        }
      ],
      "expo-web-browser"
    ],
    "extra": {
      "eas": {
        "projectId": "5e80d954-4642-498a-a372-fe2def8720bf"
      }
    }
  }
}
